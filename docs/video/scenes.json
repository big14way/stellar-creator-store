{
  "base": "https://paperstall.onrender.com",
  "viewport": [1440, 810],
  "window": [1440, 900],
  "video": [1920, 1080],
  "out": "clips",
  "accent": "#ff6a2b",
  "scenes": [
    {
      "name": "sell",
      "passkey": { "load": "creds/creator.json" },
      "steps": [
        ["goto", "/sell", "h1"],
        ["wait", 2200],
        ["moveTo", "button:has-text(\"I already have one\")"],
        ["click"],
        ["waitFor", "input[name=title]", 90000],
        ["wait", 1000],
        ["moveTo", "input[name=title]"],
        ["click"],
        ["type", "Indigo patterns, vol. 1", 45],
        ["select", "select[name=kind]", "design"],
        ["moveTo", "textarea[name=description]"],
        ["click"],
        ["type", "Six seamless SVG tiles in indigo and cream, for prints, slides and packaging. Free to use anywhere.", 12],
        ["upload", "input[name=file]", "files/indigo-patterns-vol1.zip"],
        ["upload", "input[name=cover]", "files/indigo-cover.webp"],
        ["moveTo", "label:has-text(\"Price in USDC\") input"],
        ["click"],
        ["press", "Meta+A"],
        ["type", "4", 80],
        ["moveTo", "button:has-text(\"Add a co-creator\")"],
        ["click"],
        ["moveTo", "input[aria-label=\"Co-creator 1 wallet\"]"],
        ["click"],
        ["type", "GDVRUQPAQ6AT43MOAXQVZWX4DBEW7NSSDWKBULHGRGSUXDS2LMZODRSA", 6],
        ["moveTo", "input[aria-label=\"Co-creator 1 share, %\"]"],
        ["click"],
        ["type", "20", 80],
        ["wait", 600],
        ["zoom", "[data-testid=split]", 1.35, 900, 2600],
        ["unzoom"],
        ["moveTo", "button:has-text(\"List it\")"],
        ["click"],
        ["waitUntil", "/\\/p\\/\\d+$/.test(location.pathname)", 150000],
        ["wait", 4500],
        ["saveVar", "productId", "location.pathname.split('/').pop()"]
      ]
    },
    {
      "name": "buy",
      "passkey": { "save": "creds/buyer.json" },
      "steps": [
        ["goto", "/p/{{productId}}", "h1"],
        ["wait", 3200],
        ["scrollTo", "text=Where your", 140, 1500],
        ["wait", 1200],
        ["zoom", "text=Where your", 1.3, 900, 2400, 260, 120],
        ["unzoom"],
        ["scrollBy", -3000, 1300],
        ["wait", 600],
        ["moveTo", "[data-testid=buy]"],
        ["click"],
        ["waitFor", "[data-testid=faucet]", 120000],
        ["wait", 900],
        ["moveTo", "[data-testid=faucet]"],
        ["click"],
        ["waitUntil", "!document.querySelector('[data-testid=faucet]') && /Pay/.test(document.querySelector('[data-testid=buy]')?.textContent || '')", 120000],
        ["wait", 900],
        ["moveTo", "[data-testid=buy]"],
        ["click"],
        ["waitFor", "[data-testid=download]", 150000],
        ["wait", 1600],
        ["zoom", ".owned-receipt", 1.4, 900, 3200],
        ["unzoom"],
        ["saveVar", "buyTx", "(document.querySelector('.owned-receipt a.verified') || {}).href || ''"]
      ]
    },
    {
      "name": "explorer",
      "steps": [
        ["goto", "{{buyTx}}"],
        ["wait", 7000],
        ["scrollBy", 420, 1600],
        ["wait", 3500],
        ["scrollBy", 420, 1600],
        ["wait", 3500]
      ]
    },
    {
      "name": "creator",
      "passkey": { "load": "creds/creator.json" },
      "steps": [
        ["goto", "/dashboard", "h1"],
        ["wait", 1800],
        ["moveTo", "main button:has-text(\"Sign in\")"],
        ["click"],
        ["waitUntil", "!!document.querySelector('[data-testid=balance]') && !/…/.test(document.querySelector('[data-testid=balance]').textContent)", 120000],
        ["eval", "fetch('/api/payout/CBKZD5LD5BVX4XHMGQKMAWE3NB2Q2ZQSCTEWOC56LOVD6USZPWS66TCQ', { method: 'DELETE' })"],
        ["wait", 3000],
        ["scrollTo", "[data-testid=sales-table]", 170, 1600],
        ["wait", 1500],
        ["zoom", "[data-testid=sales-table]", 1.3, 900, 3000],
        ["unzoom"],
        ["scrollTo", "#payout", 80, 1600],
        ["wait", 1800],
        ["moveTo", "[data-testid=payout-address]"],
        ["click"],
        ["type", "GD4QXXMKX7WPEKSDEDAVEO7ECSEDSWV3LFYYEUIHPIDVGZUJRTSWYBFV", 6],
        ["moveTo", "[data-testid=payout-save]"],
        ["click"],
        ["waitFor", "[data-testid=payout-saved]", 60000],
        ["wait", 2200],
        ["moveTo", "[data-testid=payout-amount]"],
        ["click"],
        ["type", "1", 80],
        ["moveTo", "[data-testid=payout-send]"],
        ["click"],
        ["waitFor", "[data-testid=payout-sent]", 150000],
        ["wait", 2200],
        ["moveTo", "[data-testid=cashout-guide] button:has-text(\"Ghana\")"],
        ["click"],
        ["wait", 3000],
        ["moveTo", "[data-testid=cashout-guide] button:has-text(\"Nigeria\")"],
        ["click"],
        ["wait", 2500]
      ]
    },
    {
      "name": "home",
      "steps": [
        ["goto", "/", "h1"],
        ["wait", 4200],
        ["moveTo", ".hero-receipt", 900],
        ["wait", 1800],
        ["scrollTo", ".aisles", 70, 1800],
        ["wait", 2800],
        ["scrollTo", ".splits", 70, 1800],
        ["wait", 2800]
      ]
    },
    {
      "name": "term_e2e",
      "viewport": [1920, 1080],
      "terminal": { "title": "end-to-end test · live site · 16 Nov 2026", "schedule": "schedules/e2e.json", "end": 18 }
    }
  ]
}
